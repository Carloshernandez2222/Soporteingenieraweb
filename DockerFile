# Dockerfile
FROM python:3.12-slim

# Evita que Python genere archivos .pyc y almacena buffers
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Instalar dependencias
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar el código fuente
COPY . .

# Exponer el puerto
EXPOSE 8000

# Comando para ejecutar (ajusta 'test' si tu instancia en conection.py se llama diferente)
CMD ["uvicorn", "Backend.conection:test", "--host", "0.0.0.0", "--port", "8000"]